# Copie para .env.local e preencha com os dados do projeto Supabase (Configurações > API).
# Nunca coloque a chave service_role aqui nem no código: o site só usa a chave pública (anon).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Endereço público do site, usado nos links enviados por e-mail.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
